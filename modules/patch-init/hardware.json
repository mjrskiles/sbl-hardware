{
  "$schema": "https://soundbytelabs.net/schema/module.schema.json",
  "schemaVersion": "0.1",
  "module": {
    "name": "patch-init",
    "revision": "1.0",
    "category": "boards"
  },

  "claims": {
    "pins": [
      {
        "pin": "b10",
        "function": "gpio",
        "direction": "in",
        "id": "gate_in_1"
      },
      {
        "pin": "b9",
        "function": "gpio",
        "direction": "in",
        "id": "gate_in_2"
      },
      {
        "pin": "b5",
        "function": "gpio",
        "direction": "out",
        "id": "gate_out_1"
      },
      {
        "pin": "b6",
        "function": "gpio",
        "direction": "out",
        "id": "gate_out_2"
      },
      {
        "pin": "c10",
        "function": "gpio",
        "direction": "out",
        "id": "cv_out_1"
      },
      {
        "pin": "c1",
        "function": "gpio",
        "direction": "out",
        "id": "cv_out_2"
      },
      {
        "pin": "b7",
        "function": "gpio",
        "direction": "in",
        "pull": "up",
        "active_low": true,
        "id": "button1"
      },
      {
        "pin": "b8",
        "function": "gpio",
        "direction": "in",
        "id": "toggle1"
      },
      {
        "pin": "d2",
        "function": "gpio",
        "direction": "out",
        "id": "sdmmc_d3"
      },
      {
        "pin": "d3",
        "function": "gpio",
        "direction": "out",
        "id": "sdmmc_d2"
      },
      {
        "pin": "d4",
        "function": "gpio",
        "direction": "out",
        "id": "sdmmc_d1"
      },
      {
        "pin": "d5",
        "function": "gpio",
        "direction": "out",
        "id": "sdmmc_d0"
      },
      {
        "pin": "d6",
        "function": "gpio",
        "direction": "out",
        "id": "sdmmc_ck"
      },
      {
        "pin": "d7",
        "function": "gpio",
        "direction": "out",
        "id": "sdmmc_cmd"
      }
    ],
    "adc": [
      { "pin": "cv_in_1", "id": "knob_1", "idle_v": 2.485 },
      { "pin": "cv_in_2", "id": "knob_2", "idle_v": 2.485 },
      { "pin": "cv_in_3", "id": "knob_3", "idle_v": 2.485 },
      { "pin": "cv_in_4", "id": "knob_4", "idle_v": 2.485 },
      { "pin": "cv_in_8", "id": "cv_5", "idle_v": 0.0 },
      { "pin": "cv_in_7", "id": "cv_6", "idle_v": 0.0 },
      { "pin": "cv_in_5", "id": "cv_7", "idle_v": 0.0 },
      { "pin": "cv_in_6", "id": "cv_8", "idle_v": 0.0 }
    ]
  },

  "components": {
    "button1": { "ref": "sbl:components/button",   "pins": {"pin": "button1"} },
    "knob1":   { "ref": "sbl:components/pot",      "pins": {"adc": "knob_1"} },
    "knob2":   { "ref": "sbl:components/pot",      "pins": {"adc": "knob_2"} },
    "knob3":   { "ref": "sbl:components/pot",      "pins": {"adc": "knob_3"} },
    "knob4":   { "ref": "sbl:components/pot",      "pins": {"adc": "knob_4"} },
    "cv5":     { "ref": "sbl:components/cv_input", "pins": {"adc": "cv_5"} },
    "cv6":     { "ref": "sbl:components/cv_input", "pins": {"adc": "cv_6"} },
    "cv7":     { "ref": "sbl:components/cv_input", "pins": {"adc": "cv_7"} },
    "cv8":     { "ref": "sbl:components/cv_input", "pins": {"adc": "cv_8"} }
  }
}
