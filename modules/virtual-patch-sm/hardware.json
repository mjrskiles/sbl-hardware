{
  "$schema": "https://soundbytelabs.net/schema/module.schema.json",
  "schemaVersion": "0.1",
  "module": {
    "name": "virtual-patch-sm",
    "manifestVersion": "1.0.0",
    "revision": "1.0",
    "main": true,
    "system": {
      "mcu": "mcu/linux-arm-host"
    }
  },

  "config": {
    "sysclk_mhz": 1
  },

  "exposes": {
    "gpio": {
      "a2":  { "mcu_pin": "GPIO2",  "functions": ["gpio"] },
      "a3":  { "mcu_pin": "GPIO3",  "functions": ["gpio"] },

      "b5":  { "mcu_pin": "GPIO5",  "functions": ["gpio"] },
      "b6":  { "mcu_pin": "GPIO6",  "functions": ["gpio"] },
      "b7":  { "mcu_pin": "GPIO7",  "functions": ["gpio"] },
      "b8":  { "mcu_pin": "GPIO8",  "functions": ["gpio"] },
      "b9":  { "mcu_pin": "GPIO9",  "functions": ["gpio"] },
      "b10": { "mcu_pin": "GPIO10", "functions": ["gpio"] },

      "c1":  { "mcu_pin": "GPIO11", "functions": ["gpio", "adc"] },
      "c2":  { "mcu_pin": "GPIO12", "functions": ["gpio", "adc"] },
      "c3":  { "mcu_pin": "GPIO13", "functions": ["gpio", "adc"] },
      "c4":  { "mcu_pin": "GPIO14", "functions": ["gpio", "adc"] },
      "c5":  { "mcu_pin": "GPIO15", "functions": ["gpio", "adc"] },
      "c6":  { "mcu_pin": "GPIO16", "functions": ["gpio", "adc"] },
      "c7":  { "mcu_pin": "GPIO17", "functions": ["gpio", "adc"] },
      "c8":  { "mcu_pin": "GPIO18", "functions": ["gpio", "adc"] },
      "c9":  { "mcu_pin": "GPIO19", "functions": ["gpio", "adc"] },
      "c10": { "mcu_pin": "GPIO20", "functions": ["gpio", "adc"] },

      "d1":  { "mcu_pin": "GPIO21", "functions": ["gpio"] },
      "d2":  { "mcu_pin": "GPIO22", "functions": ["gpio"] },
      "d3":  { "mcu_pin": "GPIO23", "functions": ["gpio"] },
      "d4":  { "mcu_pin": "GPIO24", "functions": ["gpio"] },
      "d5":  { "mcu_pin": "GPIO25", "functions": ["gpio"] },
      "d6":  { "mcu_pin": "GPIO26", "functions": ["gpio"] },
      "d7":  { "mcu_pin": "GPIO27", "functions": ["gpio"] },
      "d8":  { "mcu_pin": "GPIO28", "functions": ["gpio"] },
      "d9":  { "mcu_pin": "GPIO29", "functions": ["gpio"] },
      "d10": { "mcu_pin": "GPIO30", "functions": ["gpio"] }
    },
    "adc": {
      "cv_in_1": { "mcu_pin": "GPIO15", "mcu_channel": "ADC0_IN4", "electrical": { "range_v": [-5.0, 5.0], "bits": 16, "inverted": true } },
      "cv_in_2": { "mcu_pin": "GPIO14", "mcu_channel": "ADC0_IN3", "electrical": { "range_v": [-5.0, 5.0], "bits": 16, "inverted": true } },
      "cv_in_3": { "mcu_pin": "GPIO13", "mcu_channel": "ADC0_IN2", "electrical": { "range_v": [-5.0, 5.0], "bits": 16, "inverted": true } },
      "cv_in_4": { "mcu_pin": "GPIO12", "mcu_channel": "ADC0_IN1", "electrical": { "range_v": [-5.0, 5.0], "bits": 16, "inverted": true } },
      "cv_in_5": { "mcu_pin": "GPIO16", "mcu_channel": "ADC0_IN5", "electrical": { "range_v": [-5.0, 5.0], "bits": 16, "inverted": true } },
      "cv_in_6": { "mcu_pin": "GPIO17", "mcu_channel": "ADC0_IN6", "electrical": { "range_v": [-5.0, 5.0], "bits": 16, "inverted": true } },
      "cv_in_7": { "mcu_pin": "GPIO18", "mcu_channel": "ADC0_IN7", "electrical": { "range_v": [-5.0, 5.0], "bits": 16, "inverted": true } },
      "cv_in_8": { "mcu_pin": "GPIO19", "mcu_channel": "ADC0_IN10", "electrical": { "range_v": [-5.0, 5.0], "bits": 16, "inverted": true } },
      "adc_9":   { "mcu_pin": "GPIO2",  "mcu_channel": "ADC0_IN8", "electrical": { "range_v": [0.0, 3.3], "bits": 16 } },
      "adc_10":  { "mcu_pin": "GPIO3",  "mcu_channel": "ADC0_IN9", "electrical": { "range_v": [0.0, 3.3], "bits": 16 } },
      "adc_11":  { "mcu_pin": "GPIO20", "mcu_channel": "ADC0_IN11", "electrical": { "range_v": [0.0, 3.3], "bits": 16 } },
      "adc_12":  { "mcu_pin": "GPIO11", "mcu_channel": "ADC0_IN0", "electrical": { "range_v": [0.0, 3.3], "bits": 16 } }
    }
  },

  "claims": {
    "pins": [
      {
        "mcu_pin": "GPIO0",
        "function": "gpio",
        "direction": "out",
        "id": "status_led",
        "active_low": false
      }
    ],
    "i2c": [
      {
        "id": "codec",
        "mcu_peripheral": "I2C0",
        "scl_pin": "GPIO6",
        "sda_pin": "GPIO7",
        "speed": 100000
      }
    ],
    "uart": [
      {
        "id": "debug",
        "mcu_peripheral": "UART0",
        "tx_pin": "GPIO4",
        "rx_pin": "GPIO5",
        "baud": 115200
      }
    ]
  },

  "uses": [
    {
      "ref": "sbl:components/virtual-codec",
      "bindings": {
        "i2c": { "mcu_peripheral": "I2C0", "scl_pin": "GPIO6", "sda_pin": "GPIO7" }
      }
    }
  ]
}
